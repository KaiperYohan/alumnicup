# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Supabase dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Service role key. Bypasses RLS — server/CLI only, NEVER in the browser
# or in index.html. Used by scripts/import-to-supabase.js.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key. Safe to embed in the public page; RLS is what
# actually restricts it. Needed once the registration form is wired up.
SUPABASE_ANON_KEY=
